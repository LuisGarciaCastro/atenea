# Variables de la app (Vercel → Settings → Environment Variables, y .env.local
# en local). Para los valores aleatorios: `openssl rand -hex 32`.

# ── Acceso ─────────────────────────────────────────────────────────────

# Contraseña de la app (no hay usuarios). No la reutilices en otro sitio.
APP_PASSWORD=

# Clave con la que se firman las cookies de sesión (caducan a los 30 días).
# Cambiarla cierra todas las sesiones abiertas. Valor aleatorio largo.
SESSION_SECRET=

# ── Personalización (opcionales) ───────────────────────────────────

# Nombre con el que te saluda la app («Buenos días, <nombre>»).
NEXT_PUBLIC_NOMBRE=
# Email de contacto de /privacidad (Google lo pide si conectas Calendar).
NEXT_PUBLIC_CONTACTO_PRIVACIDAD=

# ── Base de datos ──────────────────────────────────────────────────────

# Conexión a Postgres (Neon). Vercel la crea sola al conectar la base de datos.
DATABASE_URL=

# ── Telegram ───────────────────────────────────────────────────────────

# Token del bot (te lo da @BotFather).
TELEGRAM_BOT_TOKEN=

# Único chat al que atiende el bot (tu chat personal). Obligatorio.
TELEGRAM_CHAT_ID=

# Secreto que Telegram manda en cada petición al webhook (cabecera
# X-Telegram-Bot-Api-Secret-Token). Obligatorio: sin él el webhook rechaza todo.
# Se fija al registrar el webhook (ver docs/telegram.md). Valor aleatorio largo.
TELEGRAM_WEBHOOK_SECRET=

# ── GitHub (relay de Telegram y chat) ──────────────────────────────────

# Token fine-grained con acceso a este repo y permisos:
# - Issues: Read and write
# - Pull requests: Read and write
# - Contents: Read and write (mergear PRs)
# - Actions: Read and write (el chat lanza workflows)
GITHUB_TOKEN=

# Repositorio sobre el que actúa el relay, formato "owner/repo".
GITHUB_REPOSITORY=tu-usuario/atenea

# ── Chat «Pregúntame» ──────────────────────────────────────────────────

ANTHROPIC_API_KEY=

# ── Tokens de servicio ─────────────────────────────────────────────────
# Los usan los workflows y el Atajo de iOS para llamar a la API sin sesión
# («Authorization: Bearer <token>»). Uno por módulo, valores aleatorios largos.
# Los de los workflows van también en los secretos de GitHub con el mismo nombre.

# /api/finanzas/cron/* (finanzas-categorizar.yml)
FINANZAS_CRON_SECRET=
# /api/eventos/cron/* (eventos-calendar.yml)
EVENTOS_CRON_SECRET=
# /api/contenido/cron/* (despachador y workflow del Mac de Conocimiento)
CONTENIDO_CRON_SECRET=
# /api/coach/cron (coach-diario.yml)
COACH_CRON_SECRET=
# /api/coach/cron/credenciales/* (solo el paso que recoge WHOOP y Garmin)
COACH_CREDENCIALES_SECRET=
# POST /api/gastos/directo (Atajo de iOS al pagar con Apple Pay)
GASTOS_DIRECTO_SECRET=
# POST /api/notas/directo (crear notas sin sesión)
NOTAS_DIRECTO_SECRET=

# ── Solo en los secretos de GitHub Actions (la app no las lee) ─────────
# APP_BASE_URL            Dominio de producción de la app, p. ej. https://tu-app.vercel.app
# CLAUDE_CODE_OAUTH_TOKEN Token de Claude Code para los agentes
# TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID  Para los avisos de los workflows
# YOUTUBE_API_KEY         YouTube Data API v3 (metadatos de vídeos)
# SUPADATA_API_KEY        Transcripciones de respaldo (https://supadata.ai)
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN  Google Calendar
# WHOOP_CLIENT_ID, WHOOP_CLIENT_SECRET  App de WHOOP del coach
# WHOOP_SESION_INICIAL, GARMIN_SESION_INICIAL  Solo la primera vez (ver docs/modulos.md)
# GH_RUNNERS_PAT          Lee si el runner del Mac está libre (Administration: read)
